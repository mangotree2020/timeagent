{
  "expo": {
    "name": "ON:TIME",
    "slug": "on-time",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ontime",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.ontime.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ON:TIME이 출발 위치와 이동 시간을 계산하도록 현재 위치 사용을 허용해 주세요.",
          "locationAlwaysAndWhenInUsePermission": "ON:TIME이 이동 중 화면이 꺼져도 다음 행동과 남은 시간을 안내하도록 위치 사용을 허용해 주세요.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "defaultChannel": "on-time-schedule",
          "color": "#0077B6"
        }
      ],
      [
        "@mj-studio/react-native-naver-map",
        {
          "client_id": "xhlbrzonxu",
          "android": {
            "ACCESS_FINE_LOCATION": true,
            "ACCESS_COARSE_LOCATION": true
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F4FAFD",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": [
              "https://repository.map.naver.com/archive/maven"
            ]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
