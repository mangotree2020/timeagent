# NAVER Maps client identifier. Restrict it to the registered app/package/domain.
EXPO_PUBLIC_NAVER_MAP_KEY_ID=

# Google OAuth Web client ID. Android also needs an OAuth client for com.timeagent.app and its signing SHA-1.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=18828044372-ta832lgj7vetva7u93lqilebvrhgv73j.apps.googleusercontent.com

# iOS OAuth client ID. Add the reversed client ID as the native plugin iosUrlScheme when iOS is provisioned.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Server-only NAVER Geocoding credentials. Never prefix these with EXPO_PUBLIC_.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Server-only. Never prefix with EXPO_PUBLIC_ or access it from React Native code.
TMAP_APP_KEY=

# Server-only Gemini credential for the assistant Edge Function.
GEMINI_API_KEY=

# Public URL only; the app calls this proxy instead of calling NAVER/TMAP directly.
EXPO_PUBLIC_MOBILITY_API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/mobility

# Optional public proxy URL. If omitted, the app derives /assistant from the mobility URL.
EXPO_PUBLIC_ASSISTANT_API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/assistant

# Public weather proxy URL. Set it only after the weather Edge Function is deployed.
EXPO_PUBLIC_WEATHER_API_BASE_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/weather

# Server-only decoded public-data key for KMA ultra-short observations/forecasts.
KMA_SERVICE_KEY=
